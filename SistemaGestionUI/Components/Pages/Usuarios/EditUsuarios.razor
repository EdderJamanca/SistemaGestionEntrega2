@page "/usuario/{id:int}/editar"
@inject UsuariosService Service
<div class="shadow-lg bg-white table-bordered rounded-3 py-5">
<h3 class="text-center">Edit Usuario</h3>

@if(Usuario.Id == null)
{
    <p>No existe el Usuario</p>
}
else
{
    <UsuariosFrom Usuario="Usuario"/>
}
</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private Usuario? Usuario = new Usuario();

    protected override async Task OnInitializedAsync()
    {

        Usuario = await Service.GetOneUsuario(Id);
    }

}
