@page "/Productos"
@inject ProductosService Service
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal
<h3 class="text-center">Productos</h3>
<div class="container">
    <div class="row">
        <div class="col-6">
            <div class="row">
                <div class=col-6>
                    <a href="/productos/new">
                        <button class="btn btn-success">
                            Nuevo Producto
                        </button>
                    </a>
                </div>
                
            </div>
        </div>
    </div>
    <div class="row mt-2">
        <table class="table table-responsive-lg table-bordered mx-auto table-light">
            <thead class="table-primary text-center">
                <tr>
                    <th>#</th>
                    <th>Descripcion</th>
                    <th>Costo</th>
                    <th>PrecioVenta</th>
                    <th>Stock</th>
                    <th>Usuario</th>
                    <th>Accion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Producto producto in productos)
                {
                    <tr>
                        <td class="text-center">@index</td>
                        <td class="text-center">@producto.Descripcion</td>
                        <td class="text-center">@producto.Costo</td>
                        <td class="text-center">@producto.PrecioVenta</td>
                        <td class="text-center">@producto.Stock</td>
                        <td class="text-center">@producto.Usuario.Nombre @producto.Usuario.Apellido</td>
                        <td class="text-center""">
                            <button @onclick="@(() => EliminarProducto(producto.Id))" class="btn btn-danger">
                                Eliminar
                            </button>
                            <button class="btn btn-warning text-white" @onclick="@(()=>EditarProducto(producto.Id))">
                                Editar
                            </button>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>

</div>

@code {
    private List<Producto> productos = new List<Producto>();
    public int index { get; set; } = 1;

    private string filtro = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        productos = await Service.GetProducts();

    }

    public async Task EliminarProducto(int id)
    {
        var resultado = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "¿Estas seguro?",
            Text = "se eliminar el producto",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Si, continuar",
            CancelButtonText = "No, cancelar"
        });
        var confirmado = !string.IsNullOrEmpty(resultado.Value);
        if (confirmado && resultado.IsConfirmed)
        {
            await Service.DeleteProducto(id);
            productos = await Service.GetProducts();
        }
    }
    public async Task EditarProducto(int id)
    {
        NavigationManager.NavigateTo("/productos/"+id+"/Editar");
    }

}