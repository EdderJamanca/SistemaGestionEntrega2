@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthService authService
@inject NavigationManager NavigationManager
<div class="page" style="background-color: #e9ecef; ">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar" style="background-image: linear-gradient(to right, #0f172a 0%, #0f172a 100%) !important;">
                <NavMenu />
            </div>
        </Authorized>
    </AuthorizeView>

        <AuthorizeView>
            <Authorized>
            <div class="main width100">
                <div class="top-row px-4" style="background-color: #0f172a !important; color:white;">
                            <h6 class="mt-2"><a href="/CambiarPassword" style="color:white;">@context.User.Claims.First(c => c.Type == System.Security.Claims.ClaimTypes.Actor).Value</a></h6>

                    <button type="button" @onclick="HandleLogout" class="ml-md-auto btn btn-dange text-white">Logout</button>
                        </div>
                        <div class="content px-4">
                            @Body
                        </div>
                </div>
            </Authorized>
        </AuthorizeView>
           <AuthorizeView>
                <NotAuthorized>
                     <div class="main width100">
                        <div class="content px-4">
                            @Body
                        </div>
                     </div>
                </NotAuthorized>
           </AuthorizeView>

</div>

@code {

    private async Task HandleLogout()
    {
        await authService.Logout();
        NavigationManager.NavigateTo("/");
    }

}


